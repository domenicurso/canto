{
  "name": "canto",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write index.ts src examples package.json tsconfig.json eslint.config.js .oxfmtrc.json .oxlintrc.json README.md LAYOUT_SPEC.md",
    "format:check": "oxfmt --check index.ts src examples package.json tsconfig.json eslint.config.js .oxfmtrc.json .oxlintrc.json README.md LAYOUT_SPEC.md",
    "lint": "oxlint index.ts src examples && bun run lint:structure",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun test",
    "demo": "bun examples/dashboard.ts",
    "demo:inline": "bun examples/counter.ts",
    "bench": "bun src/runtime/performance.bench.ts && bun src/runtime/rendering.bench.ts",
    "demo:form": "bun examples/form.ts",
    "demo:layout": "bun examples/layout.ts",
    "demo:tasks": "bun examples/tasks.ts",
    "demo:logs": "bun examples/logs.ts",
    "demo:virtual-list": "bun examples/virtual-list.ts",
    "demo:canvas": "bun examples/canvas.ts",
    "demo:styles": "bun examples/styles.ts",
    "lint:structure": "eslint index.ts src examples",
    "demo:interactions": "bun examples/interactions.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pngjs": "^6.0.5",
    "@xterm/headless": "^6.0.0",
    "eslint": "^9.37.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "pngjs": "^7.0.0",
    "typescript-eslint": "^8.46.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
