{
  "name": "canto",
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@types/bun": "latest",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.37.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "private": true,
  "version": "2.0.0-alpha.1",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write index.ts src examples package.json tsconfig.json eslint.config.js README.md LAYOUT_SPEC.md",
    "format:check": "prettier --check index.ts src examples package.json tsconfig.json eslint.config.js README.md LAYOUT_SPEC.md",
    "lint": "eslint index.ts src examples",
    "check": "bun run typecheck && bun run lint && bun test",
    "demo": "bun examples/dashboard.ts",
    "demo:inline": "bun examples/counter.ts",
    "bench": "bun src/runtime/performance.bench.ts",
    "demo:form": "bun examples/form.ts",
    "demo:layout": "bun examples/layout.ts",
    "demo:tasks": "bun examples/tasks.ts",
    "demo:logs": "bun examples/logs.ts",
    "demo:virtual-list": "bun examples/virtual-list.ts",
    "demo:canvas": "bun examples/canvas.ts",
    "demo:styles": "bun examples/styles.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
